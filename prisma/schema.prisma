generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  END_USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PromotionalBadge {
  SALE
  NEW
  POPULAR
  HOT
}

enum MembershipRole {
  OWNER    // Full control, can delete company
  ADMIN    // Full admin access
}

// Company (Tenant)
model Company {
  id           String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String?
  logoUrl           String?
  headerDisplayMode String   @default("both") // "both" | "logo" | "name"
  primaryColor      String   @default("#3B82F6")
  timezone     String   @default("Europe/Belgrade")
  currency     String   @default("RSD")

  // AI Configuration
  aiApiKey       String?
  aiEndpoint     String?
  aiModel        String?
  aiSystemPrompt String?

  // Bot Personality Configuration
  aiBotName      String?   // Custom bot name (e.g., "Luna", "Dr. Smith's Assistant")
  aiGreeting     String?   // Custom greeting message
  aiPersonality  String?   // Personality preset key (e.g., "professional", "friendly")

  // Business Details for Invoices
  businessAddress String?   // Full business address
  taxId           String?   // Tax ID / PIB
  vatNumber       String?   // VAT number / PDV
  bankAccount     String?   // Bank account number
  bankName        String?   // Bank name
  businessPhone   String?   // Business contact phone
  businessEmail   String?   // Business contact email
  taxRate         Decimal?  @db.Decimal(5, 2) @default(20.00)  // Configurable tax %

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users         User[]
  memberships   CompanyMembership[]
  services      Service[]
  workingHours  WorkingHours[]
  appointments  Appointment[]
  invoices      Invoice[]
  documents     Document[]
  chatSessions  ChatSession[]
  auditLogs     AuditLog[]
}

// User
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  password      String?
  image         String?
  role          UserRole  @default(END_USER)

  // Tenant relation (null for SUPER_ADMIN)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Customer Segmentation
  customerSource   String?   // "google", "referral", "direct", "social", "other"
  customerSegment  String?   // "new", "active", "loyal", "vip", "at_risk", "churned"

  // Customer Lifetime Value Metrics
  firstBookingAt   DateTime?
  lastBookingAt    DateTime?
  totalBookings    Int       @default(0)
  completedBookings Int      @default(0)
  cancelledBookings Int      @default(0)
  totalSpent       Decimal   @default(0) @db.Decimal(10, 2)
  avgBookingValue  Decimal   @default(0) @db.Decimal(10, 2)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMembership[]
  appointments  Appointment[]
  invoices      Invoice[]
  chatSessions  ChatSession[]
  auditLogs     AuditLog[]
}

// NextAuth.js Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js Verification Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Service offered by company
model Service {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  duration    Int      // Duration in minutes
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("RSD")
  color       String?  // Hex color for service badge (e.g., "#3B82F6")
  isActive    Boolean  @default(true)

  // Discount fields
  discountType       String?            // "percentage" | "fixed"
  discountValue      Decimal?           @db.Decimal(10, 2)
  discountStartDate  DateTime?
  discountEndDate    DateTime?
  promotionalBadge   PromotionalBadge?
  customBadgeLabel   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  appointments Appointment[]
  invoiceItems InvoiceLineItem[]

  @@index([companyId])
}

// Working hours for a company
model WorkingHours {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dayOfWeek   Int     // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String  // Format: "HH:mm"
  endTime     String  // Format: "HH:mm"
  isOpen      Boolean @default(true)

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

// Appointment/Booking
model Appointment {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])

  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?

  // Cancellation tracking
  cancellationReason String?
  cancelledBy        String?   // "customer" | "admin" | "system"
  cancelledAt        DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  invoice     Invoice?

  @@index([companyId])
  @@index([userId])
  @@index([serviceId])
  @@index([startTime])
}

// Invoice
model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId         String
  user           User          @relation(fields: [userId], references: [id])

  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  // @deprecated Use appointment.startTime instead. Kept for backwards compatibility.
  appointmentDate DateTime?

  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?

  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("RSD")

  notes          String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  lineItems      InvoiceLineItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([userId])
}

// Invoice Line Item
model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Discount tracking fields
  originalUnitPrice   Decimal?  @db.Decimal(10, 2)  // Price before discount
  discountType        String?                       // "percentage" | "fixed"
  discountValue       Decimal?  @db.Decimal(10, 2)  // Discount value applied
  discountPercentage  Int?                          // Calculated percentage for display

  @@index([invoiceId])
  @@index([serviceId])
}

// Document for AI context
model Document {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title     String
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Chat Session
model ChatSession {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  isRead      Boolean @default(false)  // Mark as reviewed by admin
  isImportant Boolean @default(false)  // Flag important conversations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages  ChatMessage[]

  @@index([companyId])
  @@index([userId])
}

// Chat Message
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      String      // "user" | "assistant" | "system"
  content   String      @db.Text

  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// Company Membership - allows users to own/admin multiple companies
model CompanyMembership {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(ADMIN)
  isPrimary   Boolean        @default(false)  // User's primary company for quick switching

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// Audit Log - tracks admin actions for accountability
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  entityType  String   // "Appointment" | "Invoice" | "Service" etc.
  entityId    String
  changes     Json?    // Store old/new values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
