generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  SUPER_ADMIN  // Platform admin
  USER         // Regular user - can create companies, book appointments
}

enum PlanTier {
  TRIAL      // 14-day free trial
  PRO        // Paid, base + per-company pricing
  BUSINESS   // Paid flat rate, unlimited companies
}

enum SubscriptionStatus {
  TRIALING       // In 14-day trial period
  ACTIVE         // Paid and active
  TRIAL_EXPIRED  // Trial ended, needs upgrade
  PAST_DUE       // Payment overdue
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum PromotionalBadge {
  SALE
  NEW
  POPULAR
  HOT
}

enum MembershipRole {
  OWNER    // Full control, can delete company
  ADMIN    // Full admin access
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Company (Tenant)
model Company {
  id           String   @id @default(cuid())
  slug              String   @unique
  name              String
  description       String?
  logoUrl           String?
  headerDisplayMode String   @default("both") // "both" | "logo" | "name"
  primaryColor      String   @default("#3B82F6")
  timezone     String   @default("Europe/Belgrade")
  currency     String   @default("RSD")

  // AI Configuration
  aiApiKey       String?
  aiEndpoint     String?
  aiModel        String?
  aiSystemPrompt String?

  // Bot Personality Configuration
  aiBotName      String?   // Custom bot name (e.g., "Luna", "Dr. Smith's Assistant")
  aiGreeting     String?   // Custom greeting message
  aiPersonality  String?   // Personality preset key (e.g., "professional", "friendly")

  // Channel Integration Settings
  whatsappEnabled       Boolean   @default(false)
  whatsappPhoneNumber   String?   // Display phone number shown to customers
  whatsappGreeting      String?   // Custom WhatsApp greeting message
  whatsappAutoReply     String?   // Auto-reply message outside business hours

  // WhatsApp API Credentials (company-managed, encrypted)
  whatsappAccessToken   String?   // Encrypted Meta API access token
  whatsappPhoneNumberId String?   // Meta phone number ID
  whatsappAppSecret     String?   // Encrypted - for webhook verification
  whatsappScope         String    @default("company") // "company" | "all"

  // Relation to phone mapping
  whatsappPhoneMapping  WhatsAppPhoneMapping?

  // Business Details for Invoices
  businessAddress String?   // Full business address
  taxId           String?   // Tax ID / PIB
  vatNumber       String?   // VAT number / PDV
  bankAccount     String?   // Bank account number
  bankName        String?   // Bank name
  businessPhone   String?   // Business contact phone
  businessEmail   String?   // Business contact email
  notificationEmails String[] @default([]) // Email addresses for booking notifications
  taxRate         Decimal?  @db.Decimal(5, 2) @default(20.00)  // Configurable tax %

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users         User[]
  memberships   CompanyMembership[]
  services      Service[]
  workingHours  WorkingHours[]
  appointments  Appointment[]
  invoices      Invoice[]
  documents     Document[]
  chatSessions  ChatSession[]
  auditLogs     AuditLog[]
}

// User
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  password      String?
  image         String?
  role          UserRole  @default(USER)

  // Tenant relation (null for SUPER_ADMIN)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Customer Segmentation
  customerSource   String?   // "google", "referral", "direct", "social", "other"
  customerSegment  String?   // "new", "active", "loyal", "vip", "at_risk", "churned"

  // Customer Lifetime Value Metrics
  firstBookingAt   DateTime?
  lastBookingAt    DateTime?
  totalBookings    Int       @default(0)
  completedBookings Int      @default(0)
  cancelledBookings Int      @default(0)
  totalSpent       Decimal   @default(0) @db.Decimal(10, 2)
  avgBookingValue  Decimal   @default(0) @db.Decimal(10, 2)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMembership[]
  appointments  Appointment[]
  invoices      Invoice[]
  chatSessions  ChatSession[]
  auditLogs     AuditLog[]
  subscription  UserSubscription?
  chatUsage     ChatUsage[]

  // Security relations
  accountLockout          AccountLockout?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  upgradeRequests         UpgradeRequest[]
}

// NextAuth.js Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js Verification Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Service offered by company
model Service {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  duration    Int      // Duration in minutes
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("RSD")
  color       String?  // Hex color for service badge (e.g., "#3B82F6")
  isActive    Boolean  @default(true)

  // Discount fields
  discountType       String?            // "percentage" | "fixed"
  discountValue      Decimal?           @db.Decimal(10, 2)
  discountStartDate  DateTime?
  discountEndDate    DateTime?
  promotionalBadge   PromotionalBadge?
  customBadgeLabel   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  appointments Appointment[]
  invoiceItems InvoiceLineItem[]

  @@index([companyId])
}

// Working hours for a company
model WorkingHours {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dayOfWeek   Int     // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String  // Format: "HH:mm"
  endTime     String  // Format: "HH:mm"
  isOpen      Boolean @default(true)

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

// Appointment/Booking
model Appointment {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])

  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?

  // Cancellation tracking
  cancellationReason String?
  cancelledBy        String?   // "customer" | "admin" | "system"
  cancelledAt        DateTime?

  // Reminder tracking
  reminderSentAt     DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  invoice     Invoice?

  @@index([companyId])
  @@index([userId])
  @@index([serviceId])
  @@index([startTime])
}

// Invoice
model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId         String
  user           User          @relation(fields: [userId], references: [id])

  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  // @deprecated Use appointment.startTime instead. Kept for backwards compatibility.
  appointmentDate DateTime?

  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?

  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @db.Decimal(10, 2) @default(0)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("RSD")

  notes          String?
  paidAt         DateTime?     // Timestamp when invoice was marked as paid

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  lineItems      InvoiceLineItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([userId])
}

// Invoice Line Item
model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Discount tracking fields
  originalUnitPrice   Decimal?  @db.Decimal(10, 2)  // Price before discount
  discountType        String?                       // "percentage" | "fixed"
  discountValue       Decimal?  @db.Decimal(10, 2)  // Discount value applied
  discountPercentage  Int?                          // Calculated percentage for display

  @@index([invoiceId])
  @@index([serviceId])
}

// Document for AI context
model Document {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title     String
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Chat Session
model ChatSession {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  // Channel info
  channel     String    @default("web") // "web" | "whatsapp" | "messenger" | "instagram" | "sms" | "telegram"
  phoneNumber String?   // For WhatsApp/SMS - user's phone number
  externalId  String?   // External platform conversation ID

  isRead      Boolean @default(false)  // Mark as reviewed by admin
  isImportant Boolean @default(false)  // Flag important conversations

  // Booking flow state machine (JSON: BookingState)
  bookingState Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages  ChatMessage[]

  @@index([companyId])
  @@index([userId])
  @@index([channel, phoneNumber])
}

// Chat Message
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      String      // "user" | "assistant" | "system"
  content   String      @db.Text

  // Channel delivery tracking
  status        String?   // "sent" | "delivered" | "read" | "failed"
  externalMsgId String?   // WhatsApp/Twilio message SID

  // Token usage tracking
  inputTokens   Int?
  outputTokens  Int?

  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// Company Membership - allows users to own/admin multiple companies
model CompanyMembership {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(ADMIN)
  isPrimary   Boolean        @default(false)  // User's primary company for quick switching

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// Audit Log - tracks admin actions for accountability
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  action      String   // "CREATE" | "UPDATE" | "DELETE"
  entityType  String   // "Appointment" | "Invoice" | "Service" etc.
  entityId    String
  changes     Json?    // Store old/new values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// Subscription Plan
model Plan {
  id                      String    @id @default(cuid())
  name                    String
  tier                    PlanTier  @unique
  description             String?

  // Limits (-1 = unlimited)
  baseCompanies           Int       // Companies included in base price
  maxCompanies            Int       // Max companies allowed (-1 = unlimited)
  extraCompanyPrice       Decimal?  @db.Decimal(10, 2) // Price per extra company
  maxChatMessagesPerMonth Int       // SHARED across all companies (legacy, kept for analytics)
  maxChatTokensPerMonth   Int       @default(50000) // SHARED across all companies (-1 = unlimited)
  maxDocumentsPerCompany  Int?      // Per-company doc limit (-1 = unlimited)

  // Trial settings
  trialDays               Int?      // 14 for TRIAL tier

  // Features
  customBranding          Boolean   @default(false)
  prioritySupport         Boolean   @default(false)

  // Pricing
  priceMonthly            Decimal   @db.Decimal(10, 2)
  priceCurrency           String    @default("USD")

  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  subscriptions           UserSubscription[]
}

// Subscription at USER level (not company)
model UserSubscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(TRIALING)

  // Company slots
  extraCompanySlots  Int                @default(0) // Additional companies purchased

  // Chatbot addon (for PRO plan - included in BUSINESS)
  hasChatbot         Boolean            @default(false)

  // Trial tracking
  trialEndsAt        DateTime?

  // Billing period
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime

  notes              String?            // Admin notes for manual billing

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
}

// Chat usage tracked at USER level (shared across companies)
model ChatUsage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart   DateTime // First day of month
  periodEnd     DateTime // Last day of month
  messageCount  Int      @default(0)
  tokenCount    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodStart])
  @@index([userId])
}

// Security: Login attempt tracking for rate limiting
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

// Security: Account lockout after failed login attempts
model AccountLockout {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lockedUntil])
}

// Security: Password reset tokens
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

// Security: Email verification tokens
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

// Pricing configuration (editable by super admin)
model PricingConfig {
  id                  String   @id @default(cuid())
  key                 String   @unique  // e.g., "PRO_BASE", "CHATBOT_ADDON", "EXTRA_COMPANY"
  priceEurCents       Int      // Price in EUR cents (1000 = €10)
  description         String?  // Human-readable description
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedBy           String?  // Admin who last updated
}

// Upgrade Request for bank transfer payments
model UpgradeRequest {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestedPlanTier   PlanTier             @default(PRO)
  includeChatbot      Boolean              @default(false)
  extraCompanyCount   Int                  @default(0)

  // Pricing snapshot in EUR cents (captured at request time)
  basePrice           Int                  // 1000 = €10
  chatbotPrice        Int                  // 1000 = €10 (0 if not included)
  extraCompaniesPrice Int                  // 700 × count
  totalMonthlyPrice   Int

  status              UpgradeRequestStatus @default(PENDING)
  handledBy           String?
  handledAt           DateTime?
  adminNotes          String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

// System settings (bank details, etc.)
model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// WhatsApp Phone Number to Company Mapping
// Maps Meta phone number IDs to companies for webhook routing
model WhatsAppPhoneMapping {
  id              String   @id @default(cuid())
  phoneNumberId   String   @unique  // META_PHONE_NUMBER_ID - unique across all companies
  companyId       String   @unique  // Each company can only have one phone mapping
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phoneNumberId])
}
