# =============================================================================
# BookBot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# For Docker: postgresql://postgres:postgres@db:5432/bookbot?schema=public
# For local:  postgresql://postgres:postgres@localhost:5432/bookbot?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookbot?schema=public"

# -----------------------------------------------------------------------------
# Authentication (Required)
# -----------------------------------------------------------------------------
# Secret for signing JWT tokens - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Your app's URL (no trailing slash)
# Development: http://localhost:3000
# Production:  https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email (Required for production)
# -----------------------------------------------------------------------------
# Without configuration, emails are logged to console in development

# Option 1: Resend (Recommended)
# Get your API key at: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"  # Use your verified domain in production

# Option 2: Gmail
# Create App Password at: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""

# Option 3: Custom SMTP
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public URL used in emails and client-side code
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Cron Jobs / Scheduled Tasks
# -----------------------------------------------------------------------------
# Secret for authenticating cron requests - generate with: openssl rand -base64 32
CRON_SECRET=""

# Built-in cron scheduler (for Docker/self-hosted deployments)
# Set to "true" to enable node-cron, "false" for Vercel Cron or external services
# When enabled, cron jobs run inside your Node.js process
ENABLE_CRON="false"

# Timezone for cron jobs (IANA timezone format)
# Examples: Europe/Belgrade, America/New_York, UTC
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
CRON_TIMEZONE="Europe/Belgrade"

# Test mode - runs cron every minute + immediately on startup
# WARNING: Only use for testing, never in production!
CRON_TEST_MODE="false"

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
# Super admin email for system notifications
SUPER_ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# AI Configuration (Optional)
# -----------------------------------------------------------------------------
# Companies configure their own AI keys in settings
# This is only needed if you want a global fallback
# OPENAI_API_KEY=""
